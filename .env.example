DATA_MODE=fixtures
APP_ENV=development
DATABASE_URL=sqlite:///./stocker.db
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_MODEL=
LLM_API_KEY=
# Local model: allow reasoning and complete structured research responses.
LLM_TIMEOUT=600
LLM_MAX_TOKENS=8192
# Input and output share the configured model context window.
LLM_CONTEXT_WINDOW_TOKENS=131072
LLM_RUN_OUTPUT_TOKENS=196608
LLM_RUN_TOTAL_TOKENS=1048576
LLM_RUN_CONTEXT_BYTES=8388608
RESEARCH_RUN_TIMEOUT=7200
SEC_USER_AGENT=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
# auto: try installed yfinance, then optional Alpha Vantage for U.S. history.
# Install backend[history] to enable yfinance. No API key is needed for it.
HISTORY_PROVIDER=auto
# No key needed. Set false to disable Canadian macro/FX requests.
BANK_OF_CANADA_ENABLED=true
# Optional private persistent UI AI settings path (Compose already sets /data/ai-settings/config.json).
# Native default: ignored .ai-settings/config.json at the project root.
# AI_CONFIG_FILE=/absolute/private/ai-settings/config.json
